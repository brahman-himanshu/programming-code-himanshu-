vector<int> intersection(vector<int>& a, vector<int>& b) {

    vector<int> ans;

    int i = 0;
    int j = 0;

    while (i < a.size() && j < b.size()) {

        if (a[i] < b[j]) {
            i++;
        }
        else if (b[j] < a[i]) {
            j++;
        }
        else {
            // a[i] == b[j]
            ans.push_back(a[i]);

            i++;
            j++;
        }
    }

    return ans;
}
